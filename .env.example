# Copy to .env and change the passwords. .env is git-ignored.
POSTGRES_HOST=127.0.0.1   # not localhost: see db/config.py
POSTGRES_DB=fibre
POSTGRES_USER=fibre_owner
POSTGRES_PASSWORD=change-me-owner
POSTGRES_PORT=5433
# Read-only role used by the API and GeoServer (created by Alembic)
API_DB_USER=fibre_reader
API_DB_PASSWORD=change-me-reader
GEOSERVER_ADMIN_USER=admin
GEOSERVER_ADMIN_PASSWORD=change-me-geoserver
GEOSERVER_PORT=8080
API_PORT=8000
GEOSERVER_URL=http://127.0.0.1:8080/geoserver
